  <worksheets>
    <worksheet name='Repository Landscape'>
      <layout-options>
        <title><formatted-text><run fontcolor='#172B4D' fontsize='16' bold='true'>Popularity vs. Maintenance Recency</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='Open-Source Ecosystem Intelligence' name='federated.ecosystem_intelligence' /></datasources>
          <datasource-dependencies datasource='federated.ecosystem_intelligence'>
            <column datatype='integer' name='[stars]' role='measure' type='quantitative' /><column-instance column='[stars]' derivation='Sum' name='[sum:stars:qk]' pivot='key' type='quantitative' /><column datatype='real' name='[days_since_last_push]' role='measure' type='quantitative' /><column-instance column='[days_since_last_push]' derivation='Sum' name='[sum:days_since_last_push:qk]' pivot='key' type='quantitative' /><column datatype='integer' name='[forks]' role='measure' type='quantitative' /><column-instance column='[forks]' derivation='Sum' name='[sum:forks:qk]' pivot='key' type='quantitative' /><column datatype='string' name='[maintenance_risk]' role='dimension' type='nominal' /><column-instance column='[maintenance_risk]' derivation='None' name='[none:maintenance_risk:nk]' pivot='key' type='nominal' /><column datatype='string' name='[repo_full_name]' role='dimension' type='nominal' /><column-instance column='[repo_full_name]' derivation='None' name='[none:repo_full_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'><format attr='title-font-color' value='#42526E' /></style-rule>
          <style-rule element='label'><format attr='font-color' value='#42526E' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.ecosystem_intelligence].[none:maintenance_risk:nk]' />
              <size column='[federated.ecosystem_intelligence].[sum:forks:qk]' />
              <lod column='[federated.ecosystem_intelligence].[none:repo_full_name:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='false' />
                <format attr='color' value='#2684FF' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.ecosystem_intelligence].[sum:days_since_last_push:qk]</rows>
        <cols>[federated.ecosystem_intelligence].[sum:stars:qk]</cols>
      </table>
      <simple-id uuid='{1CD2F317-53AC-5933-AC9D-D00BC6562F4B}' />
    </worksheet>
    <worksheet name='Evaluation Ranking'>
      <layout-options>
        <title><formatted-text><run fontcolor='#172B4D' fontsize='16' bold='true'>Repository Evaluation Score</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='Open-Source Ecosystem Intelligence' name='federated.ecosystem_intelligence' /></datasources>
          <datasource-dependencies datasource='federated.ecosystem_intelligence'>
            <column datatype='string' name='[repo_full_name]' role='dimension' type='nominal' /><column-instance column='[repo_full_name]' derivation='None' name='[none:repo_full_name:nk]' pivot='key' type='nominal' /><column datatype='real' name='[evaluation_score]' role='measure' type='quantitative' /><column-instance column='[evaluation_score]' derivation='Sum' name='[sum:evaluation_score:qk]' pivot='key' type='quantitative' /><column datatype='string' name='[maintenance_risk]' role='dimension' type='nominal' /><column-instance column='[maintenance_risk]' derivation='None' name='[none:maintenance_risk:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'><format attr='title-font-color' value='#42526E' /></style-rule>
          <style-rule element='label'><format attr='font-color' value='#42526E' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
