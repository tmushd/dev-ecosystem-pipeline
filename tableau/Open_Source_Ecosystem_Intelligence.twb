            <mark class='Bar' />
            <encodings>
              <color column='[federated.ecosystem_intelligence].[none:maintenance_risk:nk]' />
              <text column='[federated.ecosystem_intelligence].[sum:evaluation_score:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.ecosystem_intelligence].[none:repo_full_name:nk]</rows>
        <cols>[federated.ecosystem_intelligence].[sum:evaluation_score:qk]</cols>
      </table>
      <simple-id uuid='{1AD9B8B6-5A9B-551A-B6BB-9B2C8FFB05FB}' />
    </worksheet>
